TOP_K = 8

# Injected at wiring time: a llama_index VectorStoreIndex (or anything with
# .as_retriever). Kept injectable so tests run without an index and the
# boundary decides where the store lives.
index: Any = None


class {{ class_name }}:
    def run(self, query: str, top_k: int = TOP_K) -> list[dict]:
        if index is None:
            raise RefusedInput(
                "no index is wired -- an empty result from an unwired store "
                "would read as 'no evidence'"
            )
        nodes = index.as_retriever(similarity_top_k=top_k).retrieve(query)
        return [
            {"id": n.node_id, "score": n.score, "text": n.get_content()}
            for n in nodes
        ]
