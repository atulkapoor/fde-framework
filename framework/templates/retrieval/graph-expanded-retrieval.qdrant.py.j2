"""{{ component }}: {{ approach }}, via {{ stack }}.

{{ rationale }}

Vector entry, entity expansion, rerank exit. Qdrant answers "what resembles
this text", the adjacency map answers "what connects to what", and a reranker
earns the final order over the merged pool -- expanded chunks arrive without
a similarity score, and ordering them by hop count would pretend distance is
relevance.

The graph stays entities and co-mention edges only, rebuilt incrementally,
because this variant exists for the corpus that keeps changing.
"""

from __future__ import annotations

from collections.abc import Callable
from typing import Any

interface = "{{ interface }}"
approach = "{{ approach }}"
stack = "{{ stack }}"

COLLECTION = "{{ component }}_chunks"
TOP_K = 8
SEEDS = 20
MAX_HOPS = 2   # bounded: each hop multiplies latency, and two answers most questions
MAX_POOL = 200  # depth alone is not a bound: one hub entity can pull the corpus in


class QdrantUnwired(RuntimeError):
    """No client is wired; retrieval refuses rather than returning nothing."""


client: Any = None
embed: Callable[[str], list[float]] | None = None
rerank: Callable[[str, str], float] | None = None

# entity -> connected chunk ids, rebuilt incrementally from co-mentions.
adjacency: dict[str, list[str]] = {}


def run(query: str, top_k: int = TOP_K) -> list[dict]:
    """Seed by similarity, expand along entities, let the reranker order."""
    if client is None or embed is None or rerank is None:
        raise QdrantUnwired(
            "wire a QdrantClient, an embed(text) callable and a "
            "rerank(query, text) callable before running -- an empty result "
            "from an unwired store would read as 'no evidence'"
        )
    seeds = client.search(
        collection_name=COLLECTION, query_vector=embed(query),
        limit=SEEDS, with_payload=True,
    )
    found = {str(hit.id): {"id": str(hit.id), "hop": 0, **(hit.payload or {})}
             for hit in seeds}
    frontier = list(found)
    for hop in range(1, MAX_HOPS + 1):
        connected = [
            chunk_id
            for seed_id in frontier
            for entity in found[seed_id].get("entities", [])
            for chunk_id in adjacency.get(entity, [])
        ]
        fresh = [c for c in dict.fromkeys(connected) if c not in found]
        fresh = fresh[: max(0, MAX_POOL - len(found))]
        if not fresh:
            break
        records = client.retrieve(collection_name=COLLECTION, ids=fresh,
                                  with_payload=True)
        for record in records:
            found[str(record.id)] = {"id": str(record.id), "hop": hop,
                                     **(record.payload or {})}
        # Only ids the store actually returned: on a corpus that keeps
        # changing, the adjacency map can name a chunk deleted since the
        # last rebuild, and walking from a ghost is a KeyError in the exact
        # scenario this variant exists for.
        frontier = [str(record.id) for record in records]
    scored = [
        {**c, "rerank_score": rerank(query, c.get("text", ""))}
        for c in found.values()
    ]
    return sorted(scored, key=lambda c: -c["rerank_score"])[:top_k]
