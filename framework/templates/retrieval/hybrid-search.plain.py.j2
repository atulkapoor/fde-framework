"""{{ component }}: {{ approach }}, via {{ stack }}.

{{ rationale }}

Keyword and semantic results fused by reciprocal rank -- never by score,
because BM25 scores and cosine similarities do not share a scale, and
mixing them rewards whichever index is having a loud day.
"""

from __future__ import annotations

from collections.abc import Callable

from app.contract import RefusedInput

interface = "{{ interface }}"
approach = "{{ approach }}"
stack = "{{ stack }}"

TOP_K = 8
CANDIDATES_PER_SIDE = 25
RRF_K = 60  # the standard damping constant; rank 1 vs 2 matters, 40 vs 41 does not

# Injected at wiring time: each callable(query, k) -> ordered list of
# {"id": ..., ...} results. Two indexes, one contract.
keyword_search: Callable | None = None
semantic_search: Callable | None = None


class {{ class_name }}:
    def run(self, query: str, top_k: int = TOP_K) -> list[dict]:
        if keyword_search is None or semantic_search is None:
            raise RefusedInput(
                "both retrievers must be wired -- hybrid over one index is "
                "the single index wearing a costume"
            )
        fused: dict[str, dict] = {}
        for results in (keyword_search(query, CANDIDATES_PER_SIDE),
                        semantic_search(query, CANDIDATES_PER_SIDE)):
            for rank, item in enumerate(results):
                entry = fused.setdefault(item["id"], {**item, "rrf": 0.0})
                entry["rrf"] += 1.0 / (RRF_K + rank + 1)
        return sorted(fused.values(), key=lambda e: -e["rrf"])[:top_k]
