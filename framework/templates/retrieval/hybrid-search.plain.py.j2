"""{{ component }}: {{ approach }}, via {{ stack }}.

{{ rationale }}

Keyword and semantic results fused by reciprocal rank -- never by score,
because BM25 scores and cosine similarities do not share a scale, and
mixing them rewards whichever index is having a loud day.
"""

from __future__ import annotations

from collections.abc import Callable

from app.contract import RefusedInput
from app.shapes import require

interface = "{{ interface }}"
approach = "{{ approach }}"
stack = "{{ stack }}"

TOP_K = 8
CANDIDATES_PER_SIDE = 25
RRF_K = 60  # the standard damping constant; rank 1 vs 2 matters, 40 vs 41 does not

# Injected at wiring time: each callable(query, k) -> ordered list of
# {"id": ..., ...} results. Two indexes, one contract.
keyword_search: Callable | None = None
semantic_search: Callable | None = None


def fuse(ranked: dict[str, list[str]], k: int = RRF_K) -> list[str]:
    """Combine ranked id lists using ranks alone.

    Deliberately score-free: it works across retrievers with incompatible
    scales, and it works when one of them has no score to offer. A document
    both tiers found outranks one only either found -- that is the whole
    mechanism, and why agreement is worth more than any single score.
    """
    totals: dict[str, float] = {}
    for results in ranked.values():
        for position, doc_id in enumerate(results):
            totals[doc_id] = totals.get(doc_id, 0.0) + 1.0 / (k + position + 1)
    return sorted(totals, key=lambda d: (-totals[d], d))


class {{ class_name }}:
    def run(self, payload: dict) -> dict:
        """Envelope in, envelope out: `query` -> `retrieved`."""
        query = require(payload, "query", str, non_empty=True)
        return {**payload, "retrieved": self.retrieve(query, top_k=payload.get("k", TOP_K))}

    def retrieve(self, query: str, top_k: int = TOP_K) -> list[dict]:
        if keyword_search is None or semantic_search is None:
            raise RefusedInput(
                "both retrievers must be wired -- hybrid over one index is "
                "the single index wearing a costume"
            )
        tiers = {"keyword": keyword_search(query, CANDIDATES_PER_SIDE),
                 "semantic": semantic_search(query, CANDIDATES_PER_SIDE)}
        by_id = {item["id"]: item for results in tiers.values() for item in results}
        order = fuse({name: [item["id"] for item in results]
                      for name, results in tiers.items()})
        return [by_id[doc_id] for doc_id in order[:top_k]]
