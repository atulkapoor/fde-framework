"""{{ component }}: {{ approach }}, via {{ stack }}.

{{ rationale }}

Context held for the length of a task and then discarded.

The cheap tier, and it fails safely: a mistake here disappears when the session
ends. That is the property worth protecting, so nothing is promoted
automatically -- automatic promotion is how a passing remark becomes a permanent
belief about somebody, recalled with confidence long after everyone has
forgotten where it came from.

It is bounded. Working state that grows without limit is a context window with
extra steps, and the oldest entries are the ones least likely to matter.
"""

from __future__ import annotations

from collections import deque
from typing import Any

MAX_ENTRIES = 200


class {{ class_name }}:
    """{{ interface }}, as {{ approach }}."""

    interface = "{{ interface }}"
    approach = "{{ approach }}"
    stack = "{{ stack }}"

    def __init__(self, max_entries: int = MAX_ENTRIES) -> None:
        self._sessions: dict[str, deque] = {}
        self.max_entries = max_entries

    def note(self, session: str, observation: Any) -> None:
        self._sessions.setdefault(session, deque(maxlen=self.max_entries)).append(observation)

    def recall(self, session: str) -> list[Any]:
        return list(self._sessions.get(session, []))

    def end(self, session: str) -> None:
        """Wipe it. Nothing survives unless somebody decided it should."""
        self._sessions.pop(session, None)

    def run(self, payload: dict[str, Any]) -> dict[str, Any]:
        """Envelope in, envelope out: this session's working state under `memory`."""
        session = str(payload.get("session") or payload.get("request_id") or "local")
        if payload.get("observation") is not None:
            self.note(session, payload["observation"])
        return {**payload, "memory": self.recall(session)}
