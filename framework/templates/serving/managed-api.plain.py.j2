"""{{ component }}: {{ approach }}, via {{ stack }}.

{{ rationale }}

Somebody else's endpoint, paid per token. No infrastructure, no cold start,
nothing to operate -- the cheapest way to be wrong cheaply.

Three things this owes a client.

**Sending data here cannot be undone.** Not expensive to reverse: impossible.
That is a different category of decision, and it is the one to raise before the
first call rather than after.

**Cost is attributed as it is spent.** A per-token bill nobody can break down by
tenant is a bill nobody can act on, and reconstructing it later means replaying
traffic that was never kept.

**Failures are the vendor's and the consequences are yours.** Retries are
bounded and idempotent, because a retry storm against a rate limit is how a
transient failure becomes an outage.
"""

from __future__ import annotations

import time
from collections.abc import Callable
from typing import Any

MAX_ATTEMPTS = 3
BACKOFF_SECONDS = 0.5


class {{ class_name }}:
    """{{ interface }}, as {{ approach }}."""

    interface = "{{ interface }}"
    approach = "{{ approach }}"
    stack = "{{ stack }}"

    # Stated in the type so nothing has to remember it.
    reversibility = "one_way"

    def __init__(self, call: Callable[..., Any] | None = None, tenant: str = "default") -> None:
        self._call = call
        self.tenant = tenant
        self.spend: dict[str, dict[str, int]] = {}

    def run(self, payload: dict[str, Any]) -> dict[str, Any]:
        last: Exception | None = None
        for attempt in range(1, MAX_ATTEMPTS + 1):
            try:
                response = self._call(**payload)
            except Exception as exc:  # noqa: BLE001 - the vendor decides the type
                last = exc
                if attempt == MAX_ATTEMPTS:
                    break
                # Bounded and backed off. Retrying hard against a rate limit
                # turns a transient failure into an outage.
                time.sleep(BACKOFF_SECONDS * attempt)
                continue

            self._account(response)
            return {"response": response, "attempts": attempt}

        raise RuntimeError(f"vendor call failed after {MAX_ATTEMPTS} attempts: {last}")

    def _account(self, response: Any) -> None:
        usage = (response or {}).get("usage", {}) if isinstance(response, dict) else {}
        bucket = self.spend.setdefault(self.tenant, {"input_tokens": 0, "output_tokens": 0})
        bucket["input_tokens"] += usage.get("input_tokens", 0)
        bucket["output_tokens"] += usage.get("output_tokens", 0)

    def cost_by_tenant(self) -> dict[str, dict[str, int]]:
        return self.spend
