"""{{ component }}: {{ approach }}, via {{ stack }}.

{{ rationale }}

An embedding model running inside the boundary, because the text may not leave
and a vector is not an exception -- it is recoverable to its source.

**The model identifier is recorded with every vector.** Changing the model means
reindexing everything, and an index holding vectors from two models silently
returns nonsense: the distances are not comparable and nothing in the output
says so. Recording it turns that from a mystery into an assertion.

The batch size is deliberate. Embedding is throughput work, and doing it one
document at a time is the difference between an afternoon and a week on a large
corpus.
"""

from __future__ import annotations

from collections.abc import Callable
from typing import Any

BATCH_SIZE = 64


class IndexModelMismatch(ValueError):
    """A vector from a different model reached this index.

    Not recoverable by comparison: distances across models are not on the same
    scale, so the results look plausible and are meaningless.
    """


class {{ class_name }}:
    """{{ interface }}, as {{ approach }}."""

    interface = "{{ interface }}"
    approach = "{{ approach }}"
    stack = "{{ stack }}"

    # Recorded so a boundary check can see it without reading the code.
    runs_in_boundary = True

    def __init__(self, encode: Callable[[list[str]], list[list[float]]] | None = None,
                 model_id: str = "local", batch_size: int = BATCH_SIZE) -> None:
        self._encode = encode
        self.model_id = model_id
        self.batch_size = batch_size

    def embed(self, texts: list[str]) -> list[dict[str, Any]]:
        """Vectors, each stamped with what produced it."""
        out: list[dict[str, Any]] = []
        for start in range(0, len(texts), self.batch_size):
            chunk = texts[start : start + self.batch_size]
            for text, vector in zip(chunk, self._encode(chunk), strict=False):
                out.append({"text": text, "vector": vector, "model_id": self.model_id})
        return out

    def check_index(self, existing_model_id: str | None) -> None:
        """Refuse to add to an index built by a different model."""
        if existing_model_id and existing_model_id != self.model_id:
            raise IndexModelMismatch(
                f"index was built with {existing_model_id!r} and this is "
                f"{self.model_id!r}; mixing them returns plausible nonsense. "
                f"Reindex, which is what makes this choice expensive to reverse."
            )

    def run(self, payload: dict[str, Any]) -> Any:
        self.check_index(payload.get("index_model_id"))
        return {"vectors": self.embed(payload.get("texts", [])),
                "model_id": self.model_id, "in_boundary": self.runs_in_boundary}
