"""{{ component }}: {{ approach }}, via {{ stack }}.

{{ rationale }}

A constraint solver, which answers a different question from a model.

**It proves feasibility.** Given hard constraints it returns an assignment that
satisfies all of them, or reports that none exists -- and reporting infeasible is
a result, not a failure. A model trained on past decisions produces something
plausible that may break a constraint and has no way to tell you it did.

Two things worth setting deliberately.

**A time limit**, because an exact search on a hard instance does not finish and
a scheduler that hangs is worse than one that returns a good-enough answer.

**Which answer you got.** Optimal, feasible-within-the-time-limit and infeasible
are three different results, and a caller that cannot tell them apart will treat
the second as the first.
"""

from __future__ import annotations

from typing import Any

DEFAULT_TIME_LIMIT_SECONDS = 10.0


class Infeasible(ValueError):
    """No assignment satisfies these constraints."""


class {{ class_name }}:
    """{{ interface }}, as {{ approach }}."""

    interface = "{{ interface }}"
    approach = "{{ approach }}"
    stack = "{{ stack }}"

    def __init__(self, time_limit: float = DEFAULT_TIME_LIMIT_SECONDS) -> None:
        self.time_limit = time_limit

    def solve(self, items: list[dict[str, Any]], resources: dict[str, int]) -> dict[str, Any]:
        """Assign items to resources within capacity.

        Import is local so a project emitted for a different stack still
        imports without the dependency installed.
        """
        from ortools.sat.python import cp_model

        model = cp_model.CpModel()
        names = list(resources)
        placed = {
            (i["id"], r): model.NewBoolVar(f"{i['id']}_{r}") for i in items for r in names
        }

        for item in items:
            model.AddExactlyOne(placed[item["id"], r] for r in names)

        for resource, capacity in resources.items():
            model.Add(
                sum(placed[i["id"], resource] * i.get("size", 1) for i in items) <= capacity
            )

        solver = cp_model.CpSolver()
        solver.parameters.max_time_in_seconds = self.time_limit
        status = solver.Solve(model)

        if status not in (cp_model.OPTIMAL, cp_model.FEASIBLE):
            raise Infeasible(
                f"no assignment satisfies the capacity constraints "
                f"(items {sum(i.get('size', 1) for i in items)}, "
                f"capacity {sum(resources.values())})"
            )

        return {
            "assignment": {
                i["id"]: r for i in items for r in names
                if solver.Value(placed[i["id"], r])
            },
            "feasible": True,
            # Three different results. A caller that cannot tell them apart
            # will read the second as the first.
            "optimal": status == cp_model.OPTIMAL,
            "hit_time_limit": status == cp_model.FEASIBLE,
            "time_limit": self.time_limit,
        }

    def run(self, payload: dict[str, Any]) -> Any:
        return self.solve(payload.get("items", []), payload.get("capacity", {}))
